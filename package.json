{
  "name": "simpmusic-ecosystem",
  "version": "1.0.0",
  "description": "Ad-free cross-platform music streaming ecosystem (Web, Extension, Android APK)",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "backend": "cd backend && npm start",
    "mobile:build": "node tools/build-apps.mjs both",
    "mobile:simple": "node tools/build-apps.mjs simple",
    "mobile:elite": "node tools/build-apps.mjs elite",
    "mobile:run": "cd mobile/android && .\\gradlew.bat installSimpleDebug --parallel --build-cache --daemon"
  }
}
